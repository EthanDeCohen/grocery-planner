# Local grocery price/deal data (never commit personal shopping data)
data/
# ...but not grocery_planner/data/ (GFP-24): that's vendored, committed
# package data (the USDA snapshot grocery_planner/usda.py reads at
# runtime), not a personal data/ folder -- the bare "data/" pattern above
# would otherwise match it at any depth and silently drop it.
!grocery_planner/data/
!grocery_planner/data/**

# Your personal working copy of the planner workbook
GroceryPlanner.xlsm
GroceryPlanner.xlsx
MyGroceryPlanner.xlsm
MyGroceryPlanner.xlsx
*.local.xlsm
*.local.xlsx

# Excel lock/temp files
~$*
*.tmp

# OS noise
Thumbs.db
Desktop.ini
.DS_Store

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/

# Local SQLite databases (personal data lives in the per-OS user-data dir)
*.sqlite3
*.db

# Credentials. NEVER commit these.
#
# A client secret in git history is not fixed by a later delete commit -- it
# stays in every clone and every fork, and the only real remedy is revoking
# the credential at the provider. So these patterns are deliberately broad:
# the cost of ignoring a file by accident is that someone re-adds it with
# `git add -f`; the cost of committing one is a rotated secret and a rewritten
# history.
#
# The RIGHT home for these is the per-OS user-data dir alongside
# wholefoods_session.json (`gplan db-path` shows the folder), not the repo --
# see GFP-97. These patterns exist to catch the case where one lands here
# anyway.
kroger-env.config
*-env.config
*.credentials.json
*_credentials.json
credentials.json
.env
.env.*
secrets.*
# Agent worktrees (isolation: "worktree") live inside the repo; they are
# working copies, never content. Committing one embeds a git repo in a git repo.
.claude/worktrees/

# GFP-278: scratch sample dumps. A scraper run piped to a JSON file is a normal
# way to inspect a source, and `lidl_sample_rows.json` (92 KB, referenced by no
# code and no test) sat in the repo root for a day waiting for a `git add -A` to
# commit it. Ignored rather than forbidden -- writing them is fine, keeping them
# in history is not.
*_sample_rows.json
*_sample.json

# GFP-344: the SBOM is a build artifact, regenerated per release.
sbom.cdx.json
*.sbom.cdx.json
